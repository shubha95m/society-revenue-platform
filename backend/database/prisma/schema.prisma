// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  platform_admin
  society_admin
  resident
  vendor
}

enum UserStatus {
  active
  inactive
  suspended
  pending_verification
}

enum SocietyStatus {
  active
  onboarding
  suspended
  inactive
}

enum VendorStatus {
  active
  pending_verification
  suspended
  inactive
}

enum VendorVerificationStatus {
  unverified
  documents_submitted
  verified
  rejected
}

enum ServiceCategory {
  daily_essentials
  home_maintenance
  home_services
  health_wellness
  pet_services
  transportation
  cleaning
  food_beverage
  other
}

enum ServicePricingModel {
  per_service
  per_unit
  subscription
  custom
}

enum ServiceRequestStatus {
  pending
  under_review
  poll_created
  approved
  published
  rejected
  closed
}

enum RequirementStatus {
  active
  closed
  awarded
  expired
}

enum ProposalStatus {
  submitted
  under_review
  shortlisted
  accepted
  rejected
  withdrawn
}

enum ContractStatus {
  draft
  active
  suspended
  expired
  terminated
}

enum OrderStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  refunded
}

enum VoteCategory {
  vendor_selection
  service_requirement
  major_expense
  policy
  other
}

enum PollStatus {
  draft
  active
  closed
  passed
  failed
  invalid
}

enum VoteChoice {
  yes
  no
  abstain
}

enum ComplaintCategory {
  maintenance
  cleanliness
  security
  noise
  parking
  vendor_service
  amenity
  other
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum ComplaintStatus {
  open
  acknowledged
  in_progress
  resolved
  closed
  rejected
}

enum NoticePriority {
  low
  normal
  high
  urgent
}

enum NoticeCategory {
  announcement
  maintenance
  event
  policy
  emergency
  other
}

enum AmenityType {
  clubhouse
  swimming_pool
  gym
  sports_court
  party_hall
  meeting_room
  garden
  playground
  library
  other
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum TransactionType {
  maintenance_charge
  service_revenue
  platform_commission
  vendor_payout
  booking_fee
  penalty
  refund
  other
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum LedgerEntryType {
  debit
  credit
}

enum NotificationType {
  service_request_update
  poll_created
  poll_reminder
  proposal_received
  order_update
  complaint_update
  notice_published
  booking_confirmation
  payment_reminder
  other
}

// =====================================================
// MODELS
// =====================================================

model User {
  id                String      @id @default(uuid()) @db.Uuid
  email             String      @unique
  phone             String?     @unique
  passwordHash      String      @map("password_hash")
  firstName         String      @map("first_name") @db.VarChar(100)
  lastName          String      @map("last_name") @db.VarChar(100)
  role              UserRole
  status            UserStatus  @default(pending_verification)
  emailVerified     Boolean     @default(false) @map("email_verified")
  phoneVerified     Boolean     @default(false) @map("phone_verified")
  profileImageUrl   String?     @map("profile_image_url")
  lastLoginAt       DateTime?   @map("last_login_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  // Relations
  resident          Resident?
  vendor            Vendor?
  serviceRequests   ServiceRequest[]
  voteResponses     VoteResponse[]
  votesProposed     Vote[]                @relation("ProposedVotes")
  orders            Order[]
  complaints        Complaint[]           @relation("ComplaintReporter")
  complaintsAssigned Complaint[]          @relation("ComplaintAssignee")
  complaintsResolved Complaint[]          @relation("ComplaintResolver")
  noticesPublished  Notice[]
  amenityBookings   AmenityBooking[]
  reviewedProposals Proposal[]
  signedContracts   Contract[]
  votingsClosed     Vote[]                @relation("VoteCloser")
  notifications     Notification[]
  platformActivities PlatformAdminActivity[] @relation("AdminUser")
  affectedByActivities PlatformAdminActivity[] @relation("AffectedUser")
  reportsGenerated  Report[]
  approvedBookings  AmenityBooking[]      @relation("BookingApprover")

  @@index([email, deletedAt])
  @@index([role, deletedAt])
  @@map("users")
}

model Society {
  id                        String          @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String          @unique
  registrationNumber        String?         @unique @map("registration_number") @db.VarChar(100)

  // Location
  addressLine1              String          @map("address_line1")
  addressLine2              String?         @map("address_line2")
  city                      String          @db.VarChar(100)
  state                     String          @db.VarChar(100)
  country                   String          @default("India") @db.VarChar(100)
  pincode                   String          @db.VarChar(10)
  latitude                  Decimal?        @db.Decimal(10, 8)
  longitude                 Decimal?        @db.Decimal(11, 8)

  // Society Details
  totalFlats                Int             @map("total_flats")
  totalTowers               Int             @default(1) @map("total_towers")
  occupiedFlats             Int             @default(0) @map("occupied_flats")

  // Admin Contact
  adminName                 String?         @map("admin_name")
  adminEmail                String?         @map("admin_email")
  adminPhone                String?         @map("admin_phone") @db.VarChar(20)

  // Financial
  monthlyMaintenanceCharge  Decimal?        @map("monthly_maintenance_charge") @db.Decimal(10, 2)
  currentRevenue            Decimal         @default(0) @map("current_revenue") @db.Decimal(12, 2)
  totalRevenueGenerated     Decimal         @default(0) @map("total_revenue_generated") @db.Decimal(15, 2)

  // Status
  status                    SocietyStatus   @default(onboarding)
  onboardingCompletedAt     DateTime?       @map("onboarding_completed_at")
  subscriptionTier          String          @default("basic") @db.VarChar(50)
  subscriptionValidUntil    DateTime?       @map("subscription_valid_until") @db.Date

  // Metadata
  amenitiesInfo             Json            @default("[]") @map("amenities_info")
  settings                  Json            @default("{}")

  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")
  deletedAt                 DateTime?       @map("deleted_at")

  // Relations
  residents                 Resident[]
  serviceRequests           ServiceRequest[]
  requirements              Requirement[]
  votes                     Vote[]
  notices                   Notice[]
  amenities                 Amenity[]
  complaints                Complaint[]
  orders                    Order[]
  contracts                 Contract[]
  proposals                 Proposal[]
  vendorSocieties           VendorSociety[]
  serviceSocieties          ServiceSociety[]
  transactions              Transaction[]
  ledgerEntries             LedgerEntry[]
  reports                   Report[]
  amenityBookings           AmenityBooking[]
  platformActivities        PlatformAdminActivity[]

  @@index([slug, deletedAt])
  @@index([city, deletedAt])
  @@index([status])
  @@map("societies")
}

model Resident {
  id                        String      @id @default(uuid()) @db.Uuid
  userId                    String      @map("user_id") @db.Uuid
  societyId                 String      @map("society_id") @db.Uuid

  // Flat Details
  flatNumber                String      @map("flat_number") @db.VarChar(50)
  tower                     String?     @db.VarChar(50)
  floor                     Int?

  // Ownership
  ownershipType             String?     @map("ownership_type") @db.VarChar(50)
  moveInDate                DateTime?   @map("move_in_date") @db.Date
  familyMembers             Int         @default(1) @map("family_members")

  // Status
  isPrimaryResident         Boolean     @default(true) @map("is_primary_resident")
  isVerified                Boolean     @default(false) @map("is_verified")
  verificationDocumentUrl   String?     @map("verification_document_url")

  // Participation
  voteParticipationCount    Int         @default(0) @map("vote_participation_count")
  serviceRequestsCount      Int         @default(0) @map("service_requests_count")
  complaintsCount           Int         @default(0) @map("complaints_count")

  createdAt                 DateTime    @default(now()) @map("created_at")
  updatedAt                 DateTime    @updatedAt @map("updated_at")
  deletedAt                 DateTime?   @map("deleted_at")

  // Relations
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  society                   Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  orders                    Order[]
  complaints                Complaint[]
  voteResponses             VoteResponse[]
  amenityBookings           AmenityBooking[]

  @@unique([societyId, flatNumber, userId])
  @@index([userId, deletedAt])
  @@index([societyId, deletedAt])
  @@map("residents")
}

model Vendor {
  id                        String                      @id @default(uuid()) @db.Uuid
  userId                    String                      @map("user_id") @db.Uuid

  // Business Details
  businessName              String                      @map("business_name")
  businessType              String?                     @map("business_type") @db.VarChar(100)
  registrationNumber        String?                     @map("registration_number") @db.VarChar(100)
  gstNumber                 String?                     @map("gst_number") @db.VarChar(20)
  panNumber                 String?                     @map("pan_number") @db.VarChar(20)

  // Contact
  businessEmail             String?                     @map("business_email")
  businessPhone             String?                     @map("business_phone") @db.VarChar(20)
  websiteUrl                String?                     @map("website_url")

  // Location
  addressLine1              String?                     @map("address_line1")
  addressLine2              String?                     @map("address_line2")
  city                      String?                     @db.VarChar(100)
  state                     String?                     @db.VarChar(100)
  pincode                   String?                     @db.VarChar(10)
  serviceRadiusKm           Int                         @default(10) @map("service_radius_km")

  // Business Info
  yearsInBusiness           Int?                        @map("years_in_business")
  employeeCount             Int?                        @map("employee_count")
  description               String?

  // Ratings
  averageRating             Decimal                     @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalRatings              Int                         @default(0) @map("total_ratings")
  totalContracts            Int                         @default(0) @map("total_contracts")
  totalOrdersCompleted      Int                         @default(0) @map("total_orders_completed")
  totalRevenue              Decimal                     @default(0) @map("total_revenue") @db.Decimal(15, 2)

  // Verification
  status                    VendorStatus                @default(pending_verification)
  verificationStatus        VendorVerificationStatus    @default(unverified) @map("verification_status")
  verificationDocuments     Json                        @default("[]") @map("verification_documents")
  verifiedAt                DateTime?                   @map("verified_at")

  // Performance
  responseTimeHours         Int?                        @map("response_time_hours")
  completionRate            Decimal?                    @map("completion_rate") @db.Decimal(5, 2)

  // Metadata
  certifications            Json                        @default("[]")
  bankDetails               Json                        @default("{}") @map("bank_details")
  settings                  Json                        @default("{}")

  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  deletedAt                 DateTime?                   @map("deleted_at")

  // Relations
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorSocieties           VendorSociety[]
  serviceVendors            ServiceVendor[]
  proposals                 Proposal[]
  contracts                 Contract[]
  orders                    Order[]
  transactions              Transaction[]
  requirementViews          RequirementView[]
  platformActivities        PlatformAdminActivity[]

  @@index([userId, deletedAt])
  @@index([status])
  @@index([city, deletedAt])
  @@index([averageRating])
  @@map("vendors")
}

model VendorSociety {
  id                  String    @id @default(uuid()) @db.Uuid
  vendorId            String    @map("vendor_id") @db.Uuid
  societyId           String    @map("society_id") @db.Uuid
  status              String    @default("active") @db.VarChar(50)
  contractStartDate   DateTime? @map("contract_start_date") @db.Date
  contractEndDate     DateTime? @map("contract_end_date") @db.Date
  ordersCompleted     Int       @default(0) @map("orders_completed")
  societyRating       Decimal?  @map("society_rating") @db.Decimal(3, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  vendor              Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  society             Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([vendorId, societyId])
  @@index([vendorId])
  @@index([societyId])
  @@map("vendor_societies")
}

model Service {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  slug            String              @unique
  category        ServiceCategory
  subcategory     String?             @db.VarChar(100)
  description     String?
  pricingModel    ServicePricingModel @default(per_service) @map("pricing_model")
  basePrice       Decimal?            @map("base_price") @db.Decimal(10, 2)
  unit            String?             @db.VarChar(50)
  isActive        Boolean             @default(true) @map("is_active")
  requiresSubscription Boolean         @default(false) @map("requires_subscription")
  keywords        String[]
  tags            String[]
  iconName        String?             @map("icon_name") @db.VarChar(50)
  metadata        Json                @default("{}")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  serviceSocieties ServiceSociety[]
  serviceVendors   ServiceVendor[]
  orders           Order[]
  contracts        Contract[]

  @@index([category, deletedAt])
  @@index([slug, deletedAt])
  @@map("services")
}

model ServiceSociety {
  id                      String    @id @default(uuid()) @db.Uuid
  serviceId               String    @map("service_id") @db.Uuid
  societyId               String    @map("society_id") @db.Uuid
  isActive                Boolean   @default(true) @map("is_active")
  activatedAt             DateTime  @default(now()) @map("activated_at")
  societyPrice            Decimal?  @map("society_price") @db.Decimal(10, 2)
  discountPercentage      Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  totalOrders             Int       @default(0) @map("total_orders")
  totalResidentsUsing     Int       @default(0) @map("total_residents_using")
  monthlyRevenue          Decimal   @default(0) @map("monthly_revenue") @db.Decimal(12, 2)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  service                 Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  society                 Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([serviceId, societyId])
  @@index([serviceId])
  @@index([societyId])
  @@map("service_societies")
}

model ServiceVendor {
  id                String    @id @default(uuid()) @db.Uuid
  serviceId         String    @map("service_id") @db.Uuid
  vendorId          String    @map("vendor_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  vendorPrice       Decimal?  @map("vendor_price") @db.Decimal(10, 2)
  minOrderValue     Decimal?  @map("min_order_value") @db.Decimal(10, 2)
  maxCapacity       Int?      @map("max_capacity")
  ordersCompleted   Int       @default(0) @map("orders_completed")
  averageRating     Decimal   @default(0) @map("average_rating") @db.Decimal(3, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  service           Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vendorId])
  @@index([serviceId])
  @@index([vendorId])
  @@map("service_vendors")
}

