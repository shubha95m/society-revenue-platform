generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  platform_admin
  society_admin
  resident
  vendor
}

enum user_status {
  pending_verification
  active
  suspended
  inactive
}

enum society_status {
  active
  onboarding
  suspended
  inactive
}

model users {
  id            String      @id @db.Uuid
  email         String      @unique
  password_hash String
  first_name    String
  last_name     String
  role          user_role
  status        user_status @default(pending_verification)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  residents     residents[]
  vendors       vendors[]
}

model societies {
  id                     String    @id @db.Uuid
  name                   String
  slug                   String    @unique
  registration_number    String?   @unique
  address_line1          String
  address_line2          String?
  city                   String
  state                  String
  country                String?   @default("India")
  pincode                String
  total_flats            Int
  total_towers           Int?      @default(1)
  occupied_flats         Int?      @default(0)
  admin_name             String?
  admin_email            String?
  admin_phone            String?
  monthly_maintenance_charge Decimal? @db.Decimal(10, 2)
  current_revenue        Decimal?  @default(0) @db.Decimal(12, 2)
  total_revenue_generated Decimal? @default(0) @db.Decimal(15, 2)
  status                 society_status @default(onboarding)
  subscription_tier      String?   @default("basic")
  amenities_info         Json?     @default("[]")
  settings               Json?     @default("{}")
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  residents              residents[]
  service_societies      service_societies[]
}

model residents {
  id             String   @id @db.Uuid
  user_id        String   @db.Uuid
  society_id     String   @db.Uuid
  flat_number    String
  name           String
  phone          String?
  status         String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users          users      @relation(fields: [user_id], references: [id])
  societies      societies  @relation(fields: [society_id], references: [id])
  orders         orders[]
  complaints     complaints[]
}

model vendors {
  id                String   @id @db.Uuid
  user_id           String   @db.Uuid
  business_name     String
  business_type     String?
  phone             String?
  gst_number        String?
  status            String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  users             users    @relation(fields: [user_id], references: [id])
  services          services[]
  orders            orders[]
}

model services {
  id             String   @id @db.Uuid
  vendor_id      String   @db.Uuid
  name           String
  description    String?
  category       String
  pricing_type   String
  base_price     Decimal? @db.Decimal(10, 2)
  status         String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vendors        vendors  @relation(fields: [vendor_id], references: [id])
  orders         orders[]
  service_societies service_societies[]
}

model service_societies {
  id            String   @id @db.Uuid
  service_id    String   @db.Uuid
  society_id    String   @db.Uuid
  status        String
  created_at    DateTime @default(now())

  services      services  @relation(fields: [service_id], references: [id])
  societies     societies @relation(fields: [society_id], references: [id])
}

model orders {
  id             String   @id @db.Uuid
  resident_id    String   @db.Uuid
  service_id     String   @db.Uuid
  vendor_id      String   @db.Uuid
  order_number   String   @unique
  description    String?
  total_amount   Decimal  @db.Decimal(10, 2)
  status         String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  residents      residents @relation(fields: [resident_id], references: [id])
  services       services  @relation(fields: [service_id], references: [id])
  vendors        vendors   @relation(fields: [vendor_id], references: [id])
  transactions   transactions[]
}

model transactions {
  id                String   @id @db.Uuid
  order_id          String   @db.Uuid
  transaction_type  String
  amount            Decimal  @db.Decimal(10, 2)
  payment_method    String?
  payment_status    String
  created_at        DateTime @default(now())

  orders            orders   @relation(fields: [order_id], references: [id])
}

model complaints {
  id             String   @id @db.Uuid
  resident_id    String   @db.Uuid
  subject        String
  description    String?
  status         String
  priority       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  residents      residents @relation(fields: [resident_id], references: [id])
}
